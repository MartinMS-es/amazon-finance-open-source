{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [
      "node"
    ]
  },
  "include": [
    "app/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}